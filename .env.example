# Copia este archivo a .env en la raiz del proyecto y rellena los valores.
# El .env real esta en .gitignore y nunca se sube al repositorio.
# En produccion (Hostinger) el .env vive un nivel arriba de public_html.

APP_ENV=production
APP_TIMEZONE=America/Mexico_City

# Base de datos.
# En local, conexion.php cae por defecto a localhost/root/sin password,
# asi que puedes dejar estas variables sin definir.
DB_HOST=localhost
DB_USER=u780114275_usuario
DB_PASS=TuPasswordAqui
DB_NAME=u780114275_cat_ink

# Correo SMTP: recuperar contrasena, correos a suscriptores y publicidad.
# Sin estas variables el envio falla con "Error al enviar el correo.
# Intenta mas tarde". No tienen valor por defecto.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_PORT=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CatInk

# Correo Gmail: formulario de contacto y solicitudes de "Unete".
# El host (smtp.gmail.com), el cifrado (tls) y el puerto (587) van fijos
# en el codigo; aqui solo van las credenciales.
# GMAIL_APP_PASSWORD es una contrasena de aplicacion, no la del correo.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
GMAIL_FROM_NAME=CatInk
GMAIL_REPLY_TO=

# API de YouTube para los videos.
YOUTUBE_API_KEY=
