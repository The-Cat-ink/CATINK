@startuml CatInk_Casos_Uso_Publico
title Diagrama de Casos de Uso - CatInk (Sitio publico: Visitante, Lector y Aspirante)

left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #EF3363
  ArrowColor #475569
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontStyle bold
}

actor "Visitante\n(no autenticado)" as VIS
actor "Lector registrado"           as LEC
actor "Aspirante a vacante"         as ASP
actor "Editor"                      as EDI
actor "SMTP Hostinger"     as SMTP <<system>>
actor "Geolocalizacion IP" as GEO  <<system>>

VIS <|-- LEC

rectangle "Sistema CatInk - Frontend publico" {

  package "Consulta de contenido" {
    usecase "Ver portada"                      as UC01
    usecase "Leer noticia"                     as UC02
    usecase "Buscar noticias"                  as UC03
    usecase "Filtrar por categoria"            as UC04
    usecase "Ver rankings\n(top, populares, recientes)" as UC05
    usecase "Ver paginas informativas"         as UC06
    usecase "Registrar vista y\ntiempo de lectura" as UC07
    usecase "Ver anuncio"                      as UC08
    usecase "Registrar impresion\ny clic de anuncio" as UC43
  }

  package "Lectura sin conexion (PWA)" {
    usecase "Guardar noticia\npara leer sin conexion" as UC09
    usecase "Leer sin conexion"                as UC10
  }

  package "Cuenta de lector" {
    usecase "Registrarse"              as UC11
    usecase "Verificar correo"         as UC12
    usecase "Iniciar sesion"           as UC13
    usecase "Recuperar contrasena"     as UC14
    usecase "Editar perfil y avatar"   as UC15
    usecase "Eliminar cuenta"          as UC16
    usecase "Suscribirse al boletin"   as UC17
  }

  package "Participacion" {
    usecase "Comentar noticia"         as UC18
    usecase "Responder comentario"     as UC19
    usecase "Dar like a noticia"       as UC20
    usecase "Dar like a comentario"    as UC21
    usecase "Reportar comentario"      as UC22
    usecase "Apelar suspension"        as UC23
    usecase "Validar contenido\nofensivo" as UC24
    usecase "Verificar suspension\ndel usuario" as UC25
  }

  package "Bolsa de trabajo" {
    usecase "Ver vacantes abiertas"    as UC48
    usecase "Postular a vacante"       as UC49
    usecase "Revisar solicitudes"      as UC50
  }
}

VIS --> UC01
VIS --> UC02
VIS --> UC03
VIS --> UC04
VIS --> UC05
VIS --> UC06
VIS --> UC09
VIS --> UC10
VIS --> UC11
VIS --> UC13
VIS --> UC14
VIS --> UC17
VIS --> UC48

LEC --> UC12
LEC --> UC15
LEC --> UC16
LEC --> UC18
LEC --> UC19
LEC --> UC20
LEC --> UC21
LEC --> UC22
LEC --> UC23

ASP --> UC49
EDI --> UC50

UC11 --> SMTP
UC12 --> SMTP
UC14 --> SMTP
UC17 --> SMTP
UC49 --> SMTP
UC20 --> GEO
UC43 --> GEO

UC02 ..> UC07 : <<include>>
UC02 ..> UC08 : <<include>>
UC08 ..> UC43 : <<include>>
UC11 ..> UC12 : <<include>>
UC18 ..> UC24 : <<include>>
UC18 ..> UC25 : <<include>>
UC19 ..> UC24 : <<include>>
UC49 ..> UC50 : <<include>>

UC19 ..> UC18 : <<extend>>
UC10 ..> UC09 : <<extend>>
UC23 ..> UC25 : <<extend>>

note bottom
  UC24 y UC25 son verificaciones automaticas:
  moderacionhelper.php + filtrohelper.php validan
  el texto, y obtenerBaneo()/estaBaneado() revisan
  si la cuenta esta suspendida antes de aceptar
  cualquier comentario.
end note

@enduml
